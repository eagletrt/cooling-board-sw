digraph "fsm" {
    bgcolor="white"
    layout="dot"
    center=true
    concentrate=false

    init [
        style="filled"
        color="#66ff66"
        fillcolor="#c1ffc1"
    ]
    idle
    flash
    error [
        style="filled"
        color="#ff6666"
        fillcolor="#ffc1c1"
    ]

    // init transitions
    init -> idle  [label="init_done"]
    init -> error [label="init_error"]

    // idle transitions
    idle -> idle
    idle -> flash [label="start_flash"]
    idle -> error [label="error_detected"]

    // flash transitions
    flash -> flash
    flash -> idle  [label="flash_done"]
    flash -> error [label="error_detected"]

    // error transitions
    error -> error
}
